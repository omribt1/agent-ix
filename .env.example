# Copy to .env. Everything except the project is optional.
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
# Nano Banana and Omni are served from the global endpoint (app/agent.py forces it).
GOOGLE_CLOUD_LOCATION=global

# Assets: unset = ./.assets served by the dev server (local client only).
# Set a private bucket for Gemini Enterprise; the agent returns V4 signed URLs.
# ASSETS_BUCKET=your-assets-bucket
# SIGNED_URL_TTL_HOURS=24

# Studio layout in GE: inline (card in the chat) or canvas (side panel).
# STUDIO_LAYOUT=inline
# Side of the image embedded for the live filter preview (~80 KB per card at 800).
# LIVE_PREVIEW_SIDE=800

# Model overrides (defaults in app/config.py).
# AGENT_MODEL=gemini-3.8-flash
# CRITIC_MODEL=gemini-3.8-flash
# IMAGE_LITE_MODEL=gemini-3.1-flash-lite-image
# IMAGE_MODEL=gemini-3.1-flash-image
# IMAGE_PRO_MODEL=gemini-3-pro-image
# VIDEO_MODEL=gemini-omni-1.1-flash-preview
# Starting image tier: lite (fast drafts), nb2 or pro. Users can switch in the studio.
# DEFAULT_IMAGE_TIER=lite

# Drive export runs as the end user. In GE, register an authorization with the
# cloud-platform and drive.file scopes (not on Agent Runtime: see DRIVE_EXPORT). Set DRIVE_AUTH_ID only if you use the
# ADK auth-id pattern instead of the forwarded Authorization header.
# DRIVE_AUTH_ID=
# DRIVE_ROOT_FOLDER=Agent-I:X
# false on Agent Runtime (set by make deploy): it never sees the user token; shows Download instead
# DRIVE_EXPORT=true
# Local testing only: upload with your own ADC (log in with the drive.file scope).
# DRIVE_USE_ADC=false

# Advertise A2A streaming on the card (GE requires it; see README).
# A2A_STREAMING=true
